# =========================================================
# APSARA TALENT WEB — .env.production
# =========================================================
# Overrides NEXT_PUBLIC_API_URL for this environment. Other keys are
# inherited from .env (local) or Netlify env vars (deploy) — shown as
# comments so this file documents the full set without committing
# secrets or overriding .env real values with blanks.

# ---------------------------------------------------------
# API
# ---------------------------------------------------------
# Base URL of the API gateway (local: http://localhost:3000)
NEXT_PUBLIC_API_URL=https://apsaratalent-api-prod.up.railway.app/

# ---------------------------------------------------------
# FIREBASE (web config — public)
# ---------------------------------------------------------
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---------------------------------------------------------
# PUSH NOTIFICATIONS
# ---------------------------------------------------------
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ---------------------------------------------------------
# SENTRY — CLIENT (public, shipped in the browser bundle)
# ---------------------------------------------------------
# Explicit Sentry environment label (matches NODE_ENV here; explicit for clarity).
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
SENTRY_ENVIRONMENT=production
# blank disables client-side error reporting
# NEXT_PUBLIC_SENTRY_DSN=
# 0-1, default 0.1
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE (0-1, default 0)
# NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE (0-1, default 1)

# ---------------------------------------------------------
# SENTRY — SERVER / BUILD (secret: never commit real values)
# ---------------------------------------------------------
# usually same as NEXT_PUBLIC_SENTRY_DSN
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=
# SENTRY_ORG=
# SENTRY_PROJECT=
# source-map upload at build; set in the deployment/CI secret store only
# SENTRY_AUTH_TOKEN=
