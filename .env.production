# =========================================================
# APSARA TALENT WEB — .env.production  (TRACKED — no secrets)
# Only values that DIFFER from .env. Everything else is inherited.
# Vercel injects the real values in deployment; these cover a local
# `next build && next start`.
# =========================================================

# ---------------------------------------------------------
# PRODUCTION OVERRIDES
# ---------------------------------------------------------
# API gateway base URL
NEXT_PUBLIC_API_URL=https://apsaratalent-api-prod.up.railway.app/

# Environment label on Sentry events
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
SENTRY_ENVIRONMENT=production

# 1.0 samples every transaction and burns Sentry quota on a live app
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_TRACES_SAMPLE_RATE=0.1

# SENTRY_AUTH_TOKEN, DSNs and Firebase config are intentionally absent:
# secrets come from Vercel, shared values from .env.
