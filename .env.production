# =========================================================
# APSARA TALENT WEB - PRODUCTION
# Used when running: npm run build / npm start
# =========================================================
NEXT_PUBLIC_API_URL=https://apsaratalent-api-prod.up.railway.app/

# =========================================================
# SENTRY — production values are set in Vercel project settings
# (Environment Variables), NOT committed here. Required there:
#   NEXT_PUBLIC_SENTRY_DSN   (browser error reporting)
#   SENTRY_DSN               (server/edge error reporting)
#   SENTRY_ORG, SENTRY_PROJECT, SENTRY_AUTH_TOKEN  (source map upload at build)
# Optional: NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE, SENTRY_TRACES_SAMPLE_RATE,
#   NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE,
#   NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE
# Without the DSN vars, Sentry is silently disabled in production.
# =========================================================
