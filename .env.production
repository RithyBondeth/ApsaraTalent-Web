# =========================================================
# APSARA TALENT WEB — .env.production  (TRACKED — no secrets)
# Everything a production build needs from tracked files.
# Vercel injects the real values in deployment and those win; these cover a
# local `next build && next start`, and are what CI validates against.
#
# This file cannot rely on inheriting from .env: .env is gitignored, so it does
# not exist in CI or in a fresh clone. Anything required for a production build
# has to be here, which is why the public Firebase config is duplicated below.
# =========================================================

# ---------------------------------------------------------
# PRODUCTION OVERRIDES
# ---------------------------------------------------------
# API gateway base URL
NEXT_PUBLIC_API_URL=https://apsaratalent-api-prod.up.railway.app/

# Environment label on Sentry events
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
SENTRY_ENVIRONMENT=production

# 1.0 samples every transaction and burns Sentry quota on a live app
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------------------------------------------------------
# FIREBASE (public client config)
# ---------------------------------------------------------
# Not secrets. These ship inside the client bundle on every page load, so they
# are public the moment the app is deployed — Firebase security comes from
# security rules and App Check, never from hiding these values. They live here
# rather than only in .env because a production build must succeed from a clean
# checkout.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDnITQGotWtXV-5We43hQTWhOSSlGA6nXU
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=apsara-talent-2af93.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=apsara-talent-2af93
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=apsara-talent-2af93.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=768444244872
NEXT_PUBLIC_FIREBASE_APP_ID=1:768444244872:web:cd7139525ad5dbb08a503d
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-PY9XBN0CB7

# SENTRY_AUTH_TOKEN and the DSNs are intentionally absent — those are real
# secrets and come from Vercel and GitHub Actions.
