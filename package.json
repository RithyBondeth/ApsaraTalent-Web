{
  "name": "apsaratalent-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10"
  },
  "scripts": {
    "clean:next": "node -e \"require('fs').rmSync('.next',{ recursive: true, force: true })\"",
    "predev": "npm run clean:next",
    "dev": "next dev --turbopack -p 4000",
    "dev:turbo": "next dev --turbopack -p 4000",
    "build": "next build",
    "build:production": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run test:e2e:smoke && PLAYWRIGHT_SKIP_BUILD=1 npm run test:e2e:browser",
    "test:e2e:smoke": "node scripts/run-e2e.mjs",
    "test:e2e:browser": "playwright test",
    "test:e2e:browser:ui": "playwright test --ui",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "verify:production": "npm run lint && npm run typecheck && npm run test:ci && npm run test:e2e",
    "check:env": "node scripts/check-env.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@fontsource/preahvihear": "^5.3.0",
    "@fontsource/ubuntu": "^5.3.0",
    "@hookform/resolvers": "^4.1.3",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-hover-card": "^1.1.11",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@sentry/nextjs": "^10.68.0",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "cookies-next": "^5.1.0",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.5.2",
    "emoji-mart": "^5.6.0",
    "firebase": "^12.1.0",
    "gsap": "^3.14.2",
    "input-otp": "^1.4.2",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^0.475.0",
    "next": "^15.5.22",
    "next-intl": "^4.13.4",
    "next-themes": "^0.4.6",
    "react": "18.2.0",
    "react-day-picker": "^8.10.1",
    "react-dom": "18.2.0",
    "react-easy-crop": "^5.5.6",
    "react-hook-form": "^7.54.2",
    "react-qr-code": "^2.0.21",
    "react-resizable-panels": "^2.1.7",
    "recharts": "^3.8.1",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^15.5.22",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^20",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "^15.5.22",
    "jsdom": "^25.0.1",
    "postcss": "8.5.23",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.4",
    "brace-expansion": "5.0.9",
    "postcss": "$postcss",
    "protobufjs": "7.6.5",
    "sharp": "0.35.0"
  }
}
