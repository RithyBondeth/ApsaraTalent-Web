{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": [
    "public/firebase-messaging-sw.js",
    "scripts/start-e2e-server.mjs",

    // Nothing imports api-contract.ts — that is the point of it. tsconfig's
    // `**/*.ts` pulls it into the program, so its AssertApiSatisfies lines run
    // on every `npm run typecheck` and fail there when the API contract moves.
    // Deleting it as "unused" silently removes the drift guard.
    "utils/interfaces/api-contract.ts",
    // Its source of truth: generated by `npm run api:types`, read only by the
    // contract assertions above.
    "utils/interfaces/generated/api.ts"
  ],
  "ignoreDependencies": [
    "eslint-config-next",
    // Invoked as `npx openapi-typescript` from scripts/generate-api-types.mjs,
    // which knip cannot see. Keeping it installed is what makes that npx
    // resolve the local copy instead of fetching one.
    "openapi-typescript"
  ]
}
