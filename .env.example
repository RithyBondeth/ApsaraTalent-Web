# =========================================================
# APSARA TALENT WEB — .env.example
# Template. Copy to .env and fill in. No real values here.
#
#   cp .env.example .env  &&  node scripts/check-env.mjs
#
# FILE LAYOUT (Next.js loads these in order; LATER WINS)
#   .env              gitignored   everything for local dev — start here
#   .env.production   TRACKED      only values that DIFFER in production
#   .env.example      TRACKED      this template — no real values, ever
#   .env.local        gitignored   created and owned by the Vercel CLI.
#                                  Do not hand-edit. It outranks every file
#                                  above, so `vercel env pull` writing here
#                                  would silently override your local config.
#
# Secrets live in .env (local) and Vercel (deployed) — never in a tracked file.
# =========================================================

# ---------------------------------------------------------
# API
# ---------------------------------------------------------
# API gateway base URL
NEXT_PUBLIC_API_URL=

# ---------------------------------------------------------
# FIREBASE — web config (public, ships in the browser bundle)
# ---------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# optional; analytics only
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# web push; Firebase console > Cloud Messaging > Web Push certificates
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ---------------------------------------------------------
# SENTRY — runtime (DSNs are write-only; safe to expose)
# ---------------------------------------------------------
# browser errors; client config reads ONLY this name
NEXT_PUBLIC_SENTRY_DSN=
# server + edge errors
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
SENTRY_ENVIRONMENT=
# 0-1; blank = 0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# 0-1; blank = 0.1
SENTRY_TRACES_SAMPLE_RATE=

# ---------------------------------------------------------
# SENTRY — build (source map upload; needs CI=1 + auth token)
# ---------------------------------------------------------
SENTRY_ORG=
SENTRY_PROJECT=
# REAL CREDENTIAL — never commit
SENTRY_AUTH_TOKEN=
