# =========================================================
# APSARA TALENT WEB — .env.example
# =========================================================
# Template — copy to .env and fill in. Committed; keep it secret-free.

# ---------------------------------------------------------
# API
# ---------------------------------------------------------
# Base URL of the API gateway (local: http://localhost:3000)
NEXT_PUBLIC_API_URL=

# ---------------------------------------------------------
# FIREBASE (web config — public)
# ---------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---------------------------------------------------------
# PUSH NOTIFICATIONS
# ---------------------------------------------------------
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ---------------------------------------------------------
# SENTRY — CLIENT (public, shipped in the browser bundle)
# ---------------------------------------------------------
# blank disables client-side error reporting
NEXT_PUBLIC_SENTRY_DSN=
# 0-1, default 0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE (0-1, default 0)
# NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE (0-1, default 1)

# ---------------------------------------------------------
# SENTRY — SERVER / BUILD (secret: never commit real values)
# ---------------------------------------------------------
# usually same as NEXT_PUBLIC_SENTRY_DSN
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_ORG=
SENTRY_PROJECT=
# source-map upload at build; set in Netlify only
SENTRY_AUTH_TOKEN=
